<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!--
      allowBackup: the scan cache (SQLite) is rebuilt from the photos and stays
      out of a backup (res/xml/backup_rules.xml, data_extraction_rules.xml); the
      user's own decisions (trip names, kept photos) may be part of the phone's
      own Google backup when the user has that on. Nothing goes to the developer.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The home-screen widget: "On this day" or the space that could be freed (written by the app). -->
        <receiver
            android:name=".BildklarWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_bildklar_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- android:screenOrientation="portrait" on the activity makes Play assume the app *requires* a
         portrait screen, which keeps it off tablets, Chromebooks and Android XR ("Required hardware
         feature declarations are restricting your app's availability"). The app still opens in
         portrait; it just doesn't demand the feature. Android 16 ignores the lock on large screens anyway. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- Permissions (docs/PLAN.md, "Platform mapping") -->

    <!-- The photos: Android 13+ asks for "Photos" (all, or only selected ones from Android 14); below 13 the older storage permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Without it Android strips the GPS position from every photo, and trips can't be found. -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />

    <!-- The web view loads the app from the APK through a local address; the app itself makes no
         request to the internet (scripts/privacy-check.mjs proves it for the web build). Whether the
         release build works without this permission is an open test on a real phone — see
         docs/ANDROID_RELEASE.md, "The INTERNET permission". Until then it stays. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The weekly reminder (@capacitor/local-notifications) needs no exact alarm: a reminder a few
         minutes late is fine, and Google Play reserves exact alarms for clocks and calendars. The
         plugin then schedules inexactly. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />

    <!-- The launch phase: nothing is for sale (UNLOCK_ON_SALE = false), so the BILLING permission the
         Play Billing Library brings is removed. With it in the bundle, Play Console asks for a
         Google Payments merchant account before the app may start a closed test. Without it, the
         Purchases plugin's connection fails and every call rejects, which the app already ignores
         (store.ts catches isOwned; the paywall is never shown while nothing is on sale).
         The day the unlock goes on sale: delete this line (docs/TODO.md, 0b). -->
    <uses-permission android:name="com.android.vending.BILLING" tools:node="remove" />
</manifest>
