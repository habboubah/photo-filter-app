<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same as backup_rules.xml, for the cloud backup and a device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="bildklar-scan.db" />
        <exclude domain="database" path="bildklar-scan.db-wal" />
        <exclude domain="database" path="bildklar-scan.db-shm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="bildklar-scan.db" />
        <exclude domain="database" path="bildklar-scan.db-wal" />
        <exclude domain="database" path="bildklar-scan.db-shm" />
    </device-transfer>
</data-extraction-rules>
