{
 "about": "The App Review screen recording for the shopping list app (Einkaufsliste – ganz einfach / Shopping List – Nice & Easy), one step per line: a first shopping trip, in the order a new user meets the app — the useful parts only, about 2–3 minutes (Ahmad, 15 November 2026: no sharing, no backup export or import). The iPhone UI test (RecorderUITests) plays it on a real iPhone; scripts/rehearse-app-review.mjs plays the same file against the web build to check every label first. Step keys: see README.md. A suggestion chip's tap carries the chip's text as a second label (the chips have role=listitem; the iPhone may only see their text).",
 "app": {
  "bundleId": "com.habboubah.korb",
  "iconName": ["Shopping List", "Einkaufsliste", "قائمة التسوق"],
  "minVersion": "1.0.5"
 },
 "preflight": {
  "mustSee": ["Still to buy: 0", "Noch offen: 0", "المتبقي للشراء: 0"],
  "reset": [
   {"tap": ["Settings", "Einstellungen", "الإعدادات"], "role": "button", "timeout": 15},
   {"pause": 0.5},
   {"select": "English", "in": ["Language", "Sprache", "اللغة"]},
   {"pause": 0.5},
   {"select": "Automatic", "in": "Appearance"},
   {"scrollTo": "Reset app"},
   {"tap": "Reset app"},
   {"pause": 1},
   {"tap": "Reset app"},
   {"pause": 0.5}
  ]
 },
 "system": {
  "screenRecording": ["Screen Recording", "Bildschirmaufnahme", "Stop Recording", "Aufnahme stoppen"],
  "chooseFile": ["Choose File", "Datei auswählen", "Browse", "Durchsuchen"],
  "done": ["Done", "Fertig"],
  "update": ["Update", "Aktualisieren"],
  "open": ["Open", "Öffnen"]
 },
 "rehearsal": {
  "locale": "en-GB",
  "localStorage": {"shoppinglist-dev-native": "1"}
 },
 "scenes": [
  { "name": "Launch and the first list", "steps": [
    {"startRecording": true},
    {"launch": true},
    {"pause": 2},
    {"see": "Your lists"},
    {"pause": 1.5},
    {"tap": "Open Supermarket"},
    {"pause": 1.5},
    {"tap": ["Add “Bananas”", "Bananas"]},
    {"pause": 1},
    {"tap": ["Add “Tomatoes”", "Tomatoes"]},
    {"pause": 1},
    {"tap": ["Add “Cucumber”", "Cucumber"]},
    {"pause": 1.2},
    {"fill": "Add an item", "text": "2 kg apples"},
    {"pause": 1.2},
    {"tap": "Add “apples”", "role": "button"},
    {"pause": 1},
    {"fill": "Add an item", "text": "Milk 3x"},
    {"pause": 1.2},
    {"tap": "Add “Milk”", "role": "button"},
    {"pause": 1.5}
  ]},
  { "name": "Editing and deleting", "steps": [
    {"tap": "Edit Milk"},
    {"pause": 1.2},
    {"fill": "Note", "text": "Organic"},
    {"pause": 1},
    {"tap": "Save"},
    {"pause": 1.5},
    {"tap": "Delete Tomatoes"},
    {"pause": 1.2},
    {"tap": "Undo"},
    {"pause": 1.5}
  ]},
  { "name": "Ticking off and the basket", "steps": [
    {"tap": "Tick off Bananas"},
    {"pause": 1.2},
    {"tap": "Tick off Cucumber"},
    {"pause": 1.2},
    {"tap": "In the basket: 2"},
    {"pause": 2}
  ]},
  { "name": "Shopping mode", "steps": [
    {"tap": "Start shopping"},
    {"pause": 1.5},
    {"see": "Up next"},
    {"tap": "Into the basket"},
    {"pause": 1.2},
    {"tap": "Later"},
    {"pause": 1.2},
    {"tap": "Into the basket"},
    {"pause": 1.2},
    {"tap": "Into the basket"},
    {"pause": 1},
    {"optional": [{"tap": "Into the basket", "timeout": 1}, {"pause": 1}]},
    {"see": "All in the basket!"},
    {"pause": 2.5},
    {"tap": "Done"},
    {"pause": 1.5},
    {"tap": "Back"},
    {"pause": 1.5}
  ]},
  { "name": "A list of your own", "steps": [
    {"see": "Your lists"},
    {"tap": "New list"},
    {"pause": 1.2},
    {"tap": "Fruit & Veg"},
    {"pause": 1},
    {"fill": "Name", "text": "Saturday market"},
    {"pause": 1},
    {"tap": "Create list"},
    {"pause": 1.5},
    {"tap": ["Add “Apples”", "Apples"]},
    {"pause": 1.5},
    {"tap": "Back"},
    {"pause": 1.5}
  ]},
  { "name": "Settings: language, appearance, a list type of your own", "steps": [
    {"tap": "Settings"},
    {"pause": 1.2},
    {"select": "Deutsch", "in": "Language"},
    {"pause": 1.5},
    {"select": "English", "in": "Sprache"},
    {"pause": 1},
    {"select": "Dark", "in": "Appearance"},
    {"pause": 1.5},
    {"select": "Automatic", "in": "Appearance"},
    {"pause": 1},
    {"tap": "List types & suggestions"},
    {"pause": 1.2},
    {"scrollTo": "New type"},
    {"tap": "New type"},
    {"pause": 1.2},
    {"fill": "Name", "text": "Pet shop"},
    {"pause": 0.8},
    {"tap": "Add", "role": "button"},
    {"pause": 1.5},
    {"fill": "Add suggestion", "text": "Dog food"},
    {"pause": 0.8},
    {"tap": "Add", "role": "button"},
    {"pause": 1.5},
    {"tap": "Back"},
    {"pause": 1},
    {"tap": "Back"},
    {"pause": 1},
    {"tap": "Back"},
    {"see": "Your lists"},
    {"pause": 2},
    {"stopRecording": true}
  ]}
 ]
}
