{
 "about": "The App Review screen recording for Bildklar (Bildklar KI: Fotos aufräumen / Bildklar AI: Photo Cleaner), one step per line, from a fresh install: before every full run the script deletes the app and installs it again from TestFlight, so the video shows the first run — the welcome, the photo access (Allow Full Access: the iPhone holds only the test photos, never your own), the first scan and what it found, the first group compared and its rest marked — then a trip found by itself, a review that marks two photos, deleting what is marked (the three safety nets, the sheet that shows what goes, iOS's own dialog) and the settings. About 3 minutes plus the first scan. app.launchArguments open it in English whatever the iPhone's language. Nothing is for sale yet (UNLOCK_ON_SALE in src/logic/allowance.ts). The iPhone UI test (RecorderUITests) plays this file; scripts/rehearse-app-review.mjs plays the same file against the web build (rehearsal.library \"test\": the test library the iPhone gets) to check every label first. Step keys: see README.md.",
 "app": {
  "bundleId": "com.habboubah.bildklar",
  "iconName": [
   "Bildklar"
  ],
  "minVersion": "0.1.0",
  "launchArguments": [
   "-AppleLanguages",
   "(en)",
   "-AppleLocale",
   "en_GB"
  ]
 },
 "preflight": {
  "mustSee": [
   "Get started",
   "Los geht"
  ]
 },
 "system": {
  "screenRecording": [
   "Screen Recording",
   "Bildschirmaufnahme",
   "Stop Recording",
   "Aufnahme stoppen"
  ],
  "chooseFile": [
   "Choose File",
   "Datei auswählen",
   "Browse",
   "Durchsuchen"
  ],
  "done": [
   "Done",
   "Fertig"
  ],
  "update": [
   "Update",
   "Aktualisieren"
  ],
  "open": [
   "Open",
   "Öffnen"
  ],
  "photoAccess": [
   "Allow Full Access",
   "Limit Access…",
   "Zugriff auf alle Fotos erlauben",
   "Zugriff beschränken …",
   "Don’t Allow",
   "Nicht erlauben"
  ],
  "delete": [
   "Delete",
   "Löschen"
  ],
  "signIn": [
   "Sign In",
   "Anmelden",
   "Use Existing Apple Account",
   "Bestehenden Apple Account verwenden"
  ],
  "purchase": [
   "Purchase",
   "Kaufen",
   "Buy",
   "OK"
  ],
  "install": [
   "Install",
   "Installieren"
  ],
  "removeApp": [
   "Remove App",
   "App entfernen"
  ],
  "deleteApp": [
   "Delete App",
   "App löschen"
  ]
 },
 "rehearsal": {
  "locale": "en-GB",
  "library": "test",
  "localStorage": {}
 },
 "scenes": [
  { "name": "Launch, the welcome and the photo access", "steps": [
    {"startRecording": true},
    {"launch": true},
    {"see": "Find the photos worth keeping", "timeout": 20},
    {"pause": 2.5},
    {"tap": "Get started"},
    {"pause": 1.5},
    {"see": "your choice"},
    {"pause": 2.5},
    {"tap": "Allow access to photos"},
    {"pause": 0.8},
    {"systemAlert": ["Allow Full Access", "Zugriff auf alle Fotos erlauben"], "timeout": 8},
    {"optional": [{"systemAlert": ["Allow Full Access", "Zugriff auf alle Fotos erlauben"], "timeout": 2}]}
  ]},
  { "name": "The first scan", "steps": [
    {"note": "While the first scan runs, its hint cards say what Bildklar does."},
    {"see": "Found so far", "timeout": 20, "soft": true},
    {"pause": 2.5},
    {"pause": 4},
    {"see": ["Here’s what Bildklar found", "All tidy"], "timeout": 300},
    {"pause": 2.5},
    {"tap": ["Just look around", "Go to the overview"]},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]}
  ]},
  { "name": "Trips, found by themselves", "steps": [
    {"note": "Trips need no AI: shown first, while the AI still looks at the photos."},
    {"see": "More space", "timeout": 20},
    {"tap": "Organise", "role": "button"},
    {"pause": 1.2},
    {"optional": [{"see": "More space", "timeout": 1}, {"note": "  the tab didn't switch – tapping Organise again"}, {"tap": "Organise", "role": "button"}, {"pause": 1.2}]},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"tap": "Open Paris", "timeout": 12},
    {"pause": 2},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"scroll": "down"},
    {"pause": 1.2},
    {"tap": "Back"},
    {"pause": 1},
    {"tap": "Clean up", "role": "button"},
    {"pause": 1.2}
  ]},
  { "name": "More space: large files and month by month", "steps": [
    {"scrollTo": "Large files"},
    {"pause": 1},
    {"tap": "Large files", "role": "button"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"tap": "MB, Video", "role": "button"},
    {"pause": 1.2},
    {"tap": "Play video", "role": "button", "soft": true},
    {"pause": 3},
    {"tap": "Close"},
    {"pause": 0.8},
    {"tap": "Back"},
    {"pause": 1},
    {"tap": "Month by month", "role": "button"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"tap": "Not started", "role": "button"},
    {"pause": 2},
    {"tap": "Back"},
    {"pause": 0.8},
    {"tap": "Back"},
    {"pause": 1}
  ]},
  { "name": "Suggestions: what could go, by category", "steps": [
    {"note": "The categories come from the on-device AI: wait until it has seen the photos."},
    {"see": "Clean up now", "timeout": 150},
    {"scrollTo": "Photos: Scanned", "role": "button"},
    {"pause": 2},
    {"tap": "Duplicates", "role": "button"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"tap": "What is this?"},
    {"pause": 3},
    {"tap": "Close"},
    {"pause": 0.8},
    {"tap": "Mark unstarred", "role": "button"},
    {"pause": 1.5},
    {"tap": "Back"},
    {"pause": 1},
    {"tap": "Near-identical", "role": "button"},
    {"pause": 1.5},
    {"tap": "photos", "role": "button"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"see": "Stays"},
    {"pause": 1},
    {"tap": "Show photo 2 of"},
    {"pause": 1.5},
    {"tap": "Side by side", "soft": true},
    {"pause": 2},
    {"optional": [{"tap": "Close", "timeout": 2}, {"pause": 0.8}]},
    {"tap": "Back"},
    {"pause": 0.8},
    {"tap": "Back"},
    {"pause": 1},
    {"tap": "Failed shots", "role": "button"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"tap": "blurry", "role": "button"},
    {"pause": 2},
    {"tap": "Close"},
    {"pause": 0.8},
    {"tap": "Back"},
    {"pause": 1},
    {"optional": [{"tap": "Unimportant photos", "role": "button", "timeout": 4}, {"pause": 2.5}, {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]}, {"tap": "Back"}, {"pause": 1}]}
  ]},
  { "name": "Clean up now: quick clean and a review", "steps": [
    {"scrollTo": "Clean up now"},
    {"tap": "Clean up now", "role": "button"},
    {"pause": 2},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"pause": 1},
    {"tap": "Go through all"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"tap": "Mark for deletion", "role": "button"},
    {"pause": 1},
    {"tap": "Keep", "role": "button"},
    {"pause": 1},
    {"tap": "Later", "role": "button"},
    {"pause": 1},
    {"tap": "Undo", "role": "button"},
    {"pause": 1},
    {"tap": "Mark for deletion", "role": "button"},
    {"pause": 1},
    {"tap": "Finish"},
    {"see": "All gone through"},
    {"pause": 2.5},
    {"tap": ["Mark for deletion · "], "role": "button"},
    {"pause": 1.5},
    {"tap": "Back"},
    {"pause": 1}
  ]},
  { "name": "Marked for deletion: nothing goes without the iPhone's own question", "steps": [
    {"tap": "Marked for deletion", "role": "button"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"tap": "Delete all"},
    {"pause": 1},
    {"optional": [{"see": "Three safety nets", "timeout": 3}, {"pause": 3}, {"tap": "Got it – continue"}, {"pause": 1}]},
    {"note": "The sheet shows exactly what goes; its red button asks iOS – the recording answers Don't Allow, so the test photos stay for the next recording."},
    {"pause": 1.5},
    {"tap": "Delete", "role": "button"},
    {"pause": 1.5},
    {"systemAlert": ["Don’t Allow", "Don't Allow", "Nicht erlauben"], "timeout": 8},
    {"pause": 2},
    {"optional": [{"tap": "Back", "timeout": 2}, {"pause": 1}]}
  ]},
  { "name": "Search: what is in the photo", "steps": [
    {"see": "Clean up now"},
    {"tap": "Search", "role": "button"},
    {"pause": 1.5},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"pause": 1.5},
    {"fill": "What is in the photo?", "text": "dog"},
    {"pause": 1},
    {"tap": ["dog", "Dog"], "role": "button"},
    {"pause": 2.5},
    {"tap": ["Remove dog", "Remove Dog"], "role": "button"},
    {"pause": 0.8},
    {"fill": "What is in the photo?", "text": "beach"},
    {"pause": 1},
    {"tap": ["beach", "Beach"], "role": "button"},
    {"pause": 2.5},
    {"tap": "Back"},
    {"pause": 1}
  ]},
  { "name": "Settings and the end", "steps": [
    {"tap": "Settings"},
    {"pause": 1.2},
    {"optional": [{"tap": "Got it", "timeout": 1.2}, {"pause": 0.6}]},
    {"scrollTo": "Privacy"},
    {"pause": 1.5},
    {"tap": "Back"},
    {"see": "Clean up"},
    {"pause": 1.5},
    {"stopRecording": true}
  ]}
 ]
}
