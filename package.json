{
  "name": "bildklar",
  "private": true,
  "version": "2.0.9",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3001 --host=0.0.0.0",
    "build": "vite build --mode native && npx cap sync",
    "build:web": "vite build",
    "build:ios": "vite build --mode native && npx cap sync ios && npx cap open ios",
    "build:android": "vite build --mode native && npx cap sync android && npx cap open android",
    "android:debug": "vite build --mode native && npx cap sync android && cd android && ./gradlew assembleDebug",
    "test:android": "cd android && ./gradlew testDebugUnitTest",
    "test:ios": "swift test --package-path ios/PhotoFeatures",
    "test:ios:ai": "swift test --package-path ios/AIFeatures",
    "assets:generate": "npx @capacitor/assets generate --ios --android --iconBackgroundColor '#8AE1B7' --iconBackgroundColorDark '#8AE1B7' --splashBackgroundColor '#F2F2F7' --splashBackgroundColorDark '#000000'",
    "cities": "node scripts/cities.mjs",
    "licences": "node scripts/licences.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "store-screenshots": "node .claude/skills/store-screenshot-studio/scripts/export.mjs && node .claude/skills/store-screenshot-studio/scripts/feature_graphic.mjs && node .claude/skills/store-screenshot-studio/scripts/preview.mjs && python3 .claude/skills/store-screenshot-studio/scripts/validate.py",
    "ui-review": "node scripts/ui-review.mjs",
    "rehearse:app-review": "node scripts/rehearse-app-review.mjs",
    "record:app-review": "bash scripts/record-app-review.sh",
    "record:watch": "bash scripts/record-watch.sh",
    "app-preview": "node .claude/skills/app-preview-video/scripts/make.mjs",
    "release": "node scripts/release.js",
    "release:ios": "node scripts/release.js --ios",
    "release:android": "node scripts/release.js --android",
    "android:key": "node scripts/release-android.js --make-key",
    "release:first": "node scripts/release.js --ios --keep-version",
    "release:dry": "node scripts/release.js --dry-run",
    "preview": "vite preview --port=3001 --host=0.0.0.0",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "test": "vitest run",
    "check": "npm run lint && npm run check:security && npm test && vite build && npm run check:privacy -- --no-build && npm run check:perf -- --no-build && npm run audit:contrast && npm run check:listing && npm run check:ai",
    "check:security": "node scripts/no-console.mjs && npm audit --omit=dev --audit-level=high",
    "check:privacy": "node scripts/privacy-check.mjs",
    "check:perf": "node scripts/perf-check.mjs",
    "check:listing": "node scripts/listing-lengths.mjs",
    "check:ai": "node --experimental-strip-types scripts/ai-check.mjs",
    "demo-photos": "python3 scripts/demo-photos.py && node --experimental-strip-types scripts/demo-facts.mjs",
    "test-photos": "python3 scripts/test-photos.py",
    "test-photos:sim": "bash scripts/test-photos-push.sh ios",
    "test-photos:android": "bash scripts/test-photos-push.sh android",
    "ai:export": "python3 ml/export.py",
    "ai:eval": "python3 ml/eval.py",
    "ai:demo": "cd ml && python3 demo_ai.py && cd .. && node --experimental-strip-types scripts/demo-facts.mjs"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/status-bar": "8.0.3",
    "lucide-react": "0.546.0",
    "motion": "12.41.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/vite": "4.3.1",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.1",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
